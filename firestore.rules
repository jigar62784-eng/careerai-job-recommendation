rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for secure, least-privilege authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin permissions strictly require a trusted custom claim set via Firebase Admin SDK / Cloud Functions
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. User Identity & Role Registry:
    // Regular students can only read and create their own record with non-admin role.
    // Self-assigning 'admin' role is strictly forbidden from the client and requires trusted admin custom claim.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (
        !('role' in request.resource.data) || 
        request.resource.data.role != 'admin' || 
        isAdmin()
      );
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // 2. Student Profile Documents:
    // Strictly private to the owning candidate or authorized administrator.
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Saved Job Bookmarks:
    // Strictly private to the owning candidate or authorized administrator.
    match /saved_jobs/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 4. Job Applications Pipeline:
    // The application codebase uses top-level collection: /applications/{appId}
    // Candidates can only view, create, and modify applications tagged with their own UID.
    match /applications/{appId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Also support subcollection path /users/{userId}/applications/{applicationId} for complete compatibility
    match /users/{userId}/applications/{applicationId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 5. Job Listings Collection:
    // Publicly readable for all students, candidates, and guests.
    // Creating, modifying, or deleting job vacancies strictly requires trusted admin privileges.
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
